---
// Onglets espaces — 100 % statique + script inline.
// Pas d'île hydratée : le clavier et le clic fonctionnent dès le parse HTML
// (avant, le handler attendait le JS de l'île et restait inerte au 1er chargement).
import { EXTRANET_URL, ESPACE_TABS, PRO_ITEMS } from "../data";
import "./Espaces.css";

interface Props {
  initialTab?: "pro" | "adherent";
}

const { initialTab = "pro" } = Astro.props;
---
<section class="espaces">
  <div class="wrap">
    <div class="page-head" data-reveal="1">
      <p class="eyebrow">Espaces connectés</p>
      <h1 class="title">Les espaces Vivéa</h1>
      <p class="lede">
        Professionnel de la distribution ou adhérent de l'OP : chaque profil a
        son point d'entrée — choisissez le vôtre.
      </p>
    </div>

    <div
      class="tabs"
      role="tablist"
      aria-label="Choisir un espace"
      data-reveal="1"
    >
      {ESPACE_TABS.map((t) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          data-tab={t.id}
          data-url={t.url}
          aria-selected={initialTab === t.id ? "true" : "false"}
          aria-controls={`panel-${t.id}`}
          tabindex={initialTab === t.id ? 0 : -1}
          class:list={{ active: initialTab === t.id }}
        >
          {t.label}
        </button>
      ))}
    </div>

    <div
      class="espace-panel"
      role="tabpanel"
      id="panel-pro"
      aria-labelledby="tab-pro"
      hidden={initialTab !== "pro"}
    >
      <div class="espace-banner">
        <img
          src="/img/espace-pro.webp"
          alt="Barquettes de fruits et légumes Vivéa prêtes pour la distribution"
          width="1225"
          height="400"
        />
      </div>
      <div class="espace-body">
        <h2 class="title">Espace pro Vivéa</h2>
        <p class="espace-slogan">Quantités, qualité, service</p>
        <ul class="pro-list">
          {PRO_ITEMS.map((it) => (
            <li>
              <strong>{it.title}</strong>
              <span>{it.detail}</span>
            </li>
          ))}
        </ul>
        <div class="espace-actions">
          <a class="btn btn-primary" href="#contact">Nous contacter</a>
        </div>
      </div>
    </div>

    <div
      class="espace-panel"
      role="tabpanel"
      id="panel-adherent"
      aria-labelledby="tab-adherent"
      hidden={initialTab !== "adherent"}
    >
      <div class="espace-banner">
        <img
          src="/img/espace-adherent.webp"
          alt="Échanges entre producteurs Vivéa"
          width="1225"
          height="400"
        />
      </div>
      <div class="espace-body">
        <h2 class="title">Espace adhérent Vivéa</h2>
        <p class="lede">Vous êtes adhérent Vivéa, accédez à votre extranet :</p>
        <div class="espace-actions">
          <a
            class="btn btn-primary"
            href={EXTRANET_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Accéder à l'extranet
            <span class="ext" aria-hidden="true"> &nbsp;&#8599; </span>
            <span class="sr-only">(nouvel onglet)</span>
          </a>
        </div>
        <p class="lede espace-note">
          Vous n'êtes pas encore adhérent et souhaitez le devenir ?
        </p>
        <div class="espace-actions">
          <a class="btn btn-ghost" href="#contact">Rejoignez-nous</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Onglets : clavier ARIA APG + souris, sans hydratation.
  (function () {
    var list = document.querySelector(".tabs");
    if (!list) return;
    var buttons = Array.prototype.slice.call(
      list.querySelectorAll("button")
    );

    function select(index, moveFocus) {
      if (index < 0) index = buttons.length - 1;
      if (index >= buttons.length) index = 0;
      buttons.forEach(function (b, i) {
        var active = i === index;
        b.classList.toggle("active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
        b.tabIndex = active ? 0 : -1;
      });
      var btn = buttons[index];
      document.getElementById("panel-pro").hidden =
        btn.dataset.tab !== "pro";
      document.getElementById("panel-adherent").hidden =
        btn.dataset.tab !== "adherent";
      if (moveFocus) btn.focus();
      history.replaceState(null, "", btn.dataset.url);
    }

    list.addEventListener("keydown", function (e) {
      var i = buttons.indexOf(document.activeElement);
      if (i === -1) return;
      var next =
        e.key === "ArrowRight" ? i + 1
        : e.key === "ArrowLeft" ? i - 1
        : e.key === "Home" ? 0
        : e.key === "End" ? buttons.length - 1
        : null;
      if (next === null) return;
      e.preventDefault();
      select(next, true);
    });
    list.addEventListener("click", function (e) {
      var btn = e.target.closest("button");
      if (!btn) return;
      select(buttons.indexOf(btn), false);
    });
  })();
</script>
